{
  "private": true,
  "scripts": {
    "test:security": "node --test functions/test/security.test.js functions/test/school_registration.test.js functions/test/proxy_security.test.js functions/test/school_metrics.test.js functions/test/school_catalog.test.js scripts/test/school-public-meta-migration.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-edupro-security --config firebase.security-tests.json --only firestore,storage \"node --test --test-timeout=60000 --test-force-exit security-tests/firestore-storage.test.cjs\"",
    "test:registration": "firebase emulators:exec --project demo-edupro-security --config firebase.registration-tests.json --only auth,firestore,storage \"node --test --test-timeout=60000 --test-force-exit security-tests/school-registration.integration.test.cjs\"",
    "test:auth": "node scripts/run-auth-tests.cjs",
    "audit:secrets": "node scripts/audit-secrets.cjs --history"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    }
  }
}
