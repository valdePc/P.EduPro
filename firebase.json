{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "appcheck-local-setup.html",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/alum/**",
        "destination": "/index.html"
      },
      {
        "source": "/eduproapp/**",
        "destination": "/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/index.html"
      },
      {
        "source": "/login",
        "destination": "/index.html"
      },
      {
        "source": "/panel",
        "destination": "/index.html"
      },
      {
        "source": "/colegios",
        "destination": "/index.html"
      },
      {
        "source": "/analisis-general",
        "destination": "/index.html"
      },
      {
        "source": "/red-escolar",
        "destination": "/index.html"
      },
      {
        "source": "/facturacion",
        "destination": "/index.html"
      },
      {
        "source": "/configuracion",
        "destination": "/index.html"
      },
      {
        "source": "/pagos-facturacion",
        "destination": "/index.html"
      },
      {
        "source": "/gestion-accesos",
        "destination": "/index.html"
      },
      {
        "source": "/seguridad",
        "destination": "/index.html"
      },
      {
        "source": "/coleAdmin",
        "destination": "/index.html"
      },
      {
        "source": "/docentes",
        "destination": "/index.html"
      },
      {
        "source": "/alumnos",
        "destination": "/index.html"
      },
      {
        "source": "/admincole",
        "destination": "/index.html"
      },
      {
        "source": "/asistencia",
        "destination": "/index.html"
      },
      {
        "source": "/evaluaciones",
        "destination": "/index.html"
      },
      {
        "source": "/calendario",
        "destination": "/index.html"
      },
      {
        "source": "/planificaciones",
        "destination": "/index.html"
      },
      {
        "source": "/tarea",
        "destination": "/index.html"
      },
      {
        "source": "/estrategias",
        "destination": "/index.html"
      },
      {
        "source": "/curriculo",
        "destination": "/index.html"
      },
      {
        "source": "/estudiantes",
        "destination": "/index.html"
      },
      {
        "source": "/chat",
        "destination": "/index.html"
      },
      {
        "source": "/planificacionDocente",
        "destination": "/index.html"
      },
      {
        "source": "/colocarCalificaciones",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "edupro-8c4fd",
          "appId": "1:876132148030:android:4999d69c88109fe2a3026f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "edupro-8c4fd",
          "configurations": {
            "android": "1:876132148030:android:4999d69c88109fe2a3026f",
            "ios": "1:876132148030:ios:1d1979b772e447e4a3026f",
            "web": "1:876132148030:web:fb552569ce10b7f0a3026f"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
